# Copy to .env.test and fill in real values. .env.test is gitignored.
#
# DATABASE_URL must point at the test-data Neon branch (br-tiny-darkness-at3q6q1y,
# project purple-star-02119717) — never production. This database is wiped and
# reseeded by scripts/seed-e2e.ts on every test run. See CLAUDE.md's Tooling
# Notes for how to fetch the connection string via the Neon REST API.
DATABASE_URL=""

# A real Clerk leader login used by e2e/auth.setup.ts to sign in as a test leader.
PLAYWRIGHT_TEST_EMAIL=""
PLAYWRIGHT_TEST_PASSWORD=""
# Clerk user ID of a leader in run_leaders — used by unit tests for getLeaderRun.
# Can be any active TigerWolves leader's ID (e.g. Lou's: user_3FyCVjRa7p4xjgBGq5qRcidm0jT).
PLAYWRIGHT_TEST_CLERK_USER_ID=""

# A real Clerk login with NO leader role, used by e2e/auth.setup.ts to sign in as
# a non-leader for the #337 route-gating specs (e2e/gating.spec.ts). Must live on
# the same Clerk instance as PLAYWRIGHT_TEST_EMAIL and must never be granted the
# 'leader' role. Dedicated account: foulox+runner@gmail.com. Ticket-based sign-in,
# so no password is needed here.
PLAYWRIGHT_RUNNER_EMAIL=""

# Clerk API keys for whichever Clerk instance PLAYWRIGHT_TEST_EMAIL's leader
# account actually lives on. Without these the dev server falls back to a
# generic Clerk demo instance that doesn't recognize the login above — the
# "Couldn't find your account" failure this causes looks like a bad
# email/password, but is actually a missing/mismatched key pair.
#
# These are the CI/TEST Clerk instance keys — the instance where PLAYWRIGHT_TEST_EMAIL
# lives (historically called the "dev" instance). As of #427 the DEMO is its own,
# separate Clerk instance: its keys are NOT set here. The demo instance's keys live
# only on the demo Vercel project, and its CLERK_SECRET_KEY is passed to
# scripts/refresh-demo.ts at runtime — never via this file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# A dedicated CI-only Upstash Redis instance (its REST URL + token). @vercel/kv
# throws on first use if these are missing, crashing any page whose server render
# reads the votes/race-tags store (e.g. /run-config) — the failure looks like an
# unrelated assertion (a page that won't load) rather than a missing-env error.
# Use a throwaway Upstash DB, NOT Preview/production KV: e2e vote/rating writes
# land here, so this must not be a store whose contents you care about. In CI
# these come from the KV_REST_API_URL / KV_REST_API_TOKEN GitHub Actions secrets.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
